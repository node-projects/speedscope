{
  "name": "@node-projects/speedscope",
  "version": "2.0.0",
  "description": "A fast, interactive performance profile viewer with large-trace improvements, an accessible call tree and offline CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-projects/speedscope.git"
  },
  "homepage": "https://node-projects.github.io/speedscope/",
  "bugs": {
    "url": "https://github.com/node-projects/speedscope/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "src/lib/file-format-spec.ts",
  "bin": {
    "speedscope": "./bin/cli.mjs"
  },
  "scripts": {
    "backlog:generate": "node scripts/generate-issue-backlog.mjs",
    "backlog:check": "node scripts/generate-issue-backlog.mjs --check",
    "build:pages": "node scripts/prepare-release.mjs --protocol http",
    "build:single-file": "tsx scripts/build-single-file.ts",
    "deploy": "gh workflow run pages.yml --ref main",
    "release:version": "node scripts/set-release-version.mjs",
    "prepack": "node scripts/prepare-release.mjs",
    "prettier": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "jest": "node scripts/test-setup.mjs && jest --runInBand",
    "coverage": "npm run jest -- --coverage",
    "typecheck": "tsc --noEmit",
    "test:node": "node --test bin/server.test.mjs scripts/set-release-version.test.mjs",
    "schema:check": "node scripts/generate-file-format-schema-json.js --check",
    "test": "npm run typecheck && npm run lint && npm run jest && npm run test:node && npm run schema:check && npm run backlog:check",
    "serve": "tsx scripts/dev-server.ts"
  },
  "files": [
    "src/lib/file-format-spec.ts",
    "docs/RELEASING.md",
    "docs/LARGE_TRACE_PERFORMANCE.md",
    "docs/PROFILE_FILTERS.md",
    "docs/SEARCH_AND_LAYOUT.md",
    "docs/SOURCE_AND_LABELS.md",
    "docs/JAVA_THREAD_DUMPS.md",
    "docs/JAVA_THREAD_DUMP_ZIP.md",
    "docs/IMPORT_FORMATS.md",
    "docs/OFFLINE.md",
    "docs/SINGLE_FILE.md",
    "docs/PROPERTY_TESTS.md",
    "bin/cli.mjs",
    "bin/server.mjs",
    "dist/release/**",
    "!*.map"
  ],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ],
  "author": {
    "name": "node-projects",
    "url": "https://github.com/node-projects"
  },
  "license": "MIT",
  "devDependencies": {
    "@streamparser/json": "0.0.26",
    "@types/jest": "22.2.3",
    "@types/jszip": "3.1.4",
    "@types/node": "14.0.1",
    "@types/pako": "1.0.0",
    "@typescript-eslint/eslint-plugin": "6.16.0",
    "@typescript-eslint/parser": "6.16.0",
    "acorn": "7.2.0",
    "aphrodite": "2.1.0",
    "esbuild": "0.27.0",
    "esbuild-jest": "0.5.0",
    "eslint": "8.0.0",
    "eslint-plugin-prettier": "5.1.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "fast-check": "4.10.3",
    "jest": "30.2.0",
    "jest-environment-jsdom": "29.7.0",
    "jfrview": "0.2.0",
    "jsverify": "0.8.3",
    "jszip": "3.1.5",
    "pako": "1.0.6",
    "preact": "10.4.1",
    "prettier": "3.1.1",
    "protobufjs": "6.8.8",
    "source-map": "0.6.1",
    "ts-jest": "29.4.6",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-json-schema": "0.67.0",
    "uglify-es": "3.2.2",
    "uint8array-json-parser": "0.0.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.js$": "esbuild-jest"
    },
    "transformIgnorePatterns": [],
    "setupFilesAfterEnv": [
      "./src/jest-setup.js"
    ],
    "moduleNameMapper": {
      "\\jfrview_bg.wasm$": "<rootDir>/src/import/java-flight-record.mock.ts"
    },
    "testRegex": "\\.test\\.tsx?$",
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.{ts,tsx}"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "dependencies": {
    "open": "10.1.0"
  }
}
